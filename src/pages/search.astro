---
import Base from "@/layouts/Base.astro";
import EssayEntry from "@/components/EssayEntry.astro";
import { repoFrom, envFrom } from "@/lib/context";
import { pageMeta } from "@/lib/domain/seo";
import { normalizeQuery } from "@/lib/domain/search";
import { siteUrl } from "@/config/site";

const repo = repoFrom(Astro.locals);
const settings = await repo.getSettings();
const q = normalizeQuery(Astro.url.searchParams.get("q") ?? "");
const results = q ? await repo.searchPublished(q) : [];
const meta = pageMeta({ path: "/search", title: "Search" }, settings, siteUrl(envFrom(Astro.locals)));
const subtitle = !q
  ? "Find an essay by a word, a topic or a tag."
  : results.length === 0
    ? `Nothing found for “${q}”.`
    : `${results.length} ${results.length === 1 ? "result" : "results"} for “${q}”.`;
---

<Base meta={meta}>
  <section class="wrap page-head">
    <div>
      <h1>Search</h1>
      <p class="sub">{subtitle}</p>
    </div>
    <form class="search-line" method="GET" action="/search" role="search">
      <span class="search-icon" aria-hidden="true"></span>
      <label class="visually-hidden" for="q">Search essays</label>
      <input type="search" id="q" name="q" value={q} placeholder="Search essays" autofocus />
    </form>
  </section>

  {results.length > 0 && (
    <section class="wrap rail year-group">
      <div class="label">Results</div>
      <div class="entries">
        {results.map((p) => <EssayEntry post={p} />)}
      </div>
    </section>
  )}
  <div class="page-footer-gap"></div>
</Base>
