---
import Base from "@/layouts/Base.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Subscribe from "@/components/Subscribe.astro";
import { repoFrom, envFrom } from "@/lib/context";
import { pageMeta } from "@/lib/domain/seo";
import { paragraphs } from "@/lib/domain/html";
import { readingTimeMinutes } from "@/lib/domain/reading-time";
import { formatDate, isoDate } from "@/lib/format";
import { siteUrl } from "@/config/site";
import type { HomeSection, HomeSectionKey } from "@/lib/domain/types";

const repo = repoFrom(Astro.locals);
const [settings, featured, pages, categories, about] = await Promise.all([
  repo.getSettings(),
  repo.getFeatured(),
  repo.listMenuPages(),
  repo.listCategories(),
  repo.getPublishedPageBySlug("about"),
]);
const exclude = featured ? [featured.id] : [];
const layout = settings.homeLayout;
const section = Object.fromEntries(layout.sections.map((x) => [x.key, x])) as Record<HomeSectionKey, HomeSection>;
const showing = (key: HomeSectionKey) => section[key]?.visible !== false;
const [newest, counts] = await Promise.all([
  repo.listPublished({ limit: layout.latestCount + 1 }),
  Promise.all(categories.map((c) => repo.countPublished({ categorySlug: c.slug }))),
]);
const latest = newest.filter((p) => !exclude.includes(p.id)).slice(0, layout.latestCount);
// Most read never repeats the hero. It also skips essays already in Latest,
// but only while that still leaves at least two to show — on a young blog it's
// better to repeat an essay than to lose the section.
const latestIds = showing("latest") ? latest.map((p) => p.id) : [];
const deduped = latestIds.length ? await repo.listMostRead(layout.mostReadCount, [...exclude, ...latestIds]) : [];
const mostRead = deduped.length >= 2 ? deduped : await repo.listMostRead(layout.mostReadCount, exclude);
const topics = categories.map((c, i) => ({ ...c, count: counts[i] })).filter((c) => c.count > 0);
const [aboutLead = "", aboutBody = ""] = about ? paragraphs(about.bodyHtml) : [];
// Shown in the portrait frame until a photo is chosen in Settings.
const initials = settings.authorName.split(/\s+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join("").toUpperCase();
const mins = (html: string) => readingTimeMinutes(html);

// Sections that are switched on AND have something to show, in Pradeep's order.
const hasContent: Record<HomeSectionKey, boolean> = {
  mostRead: mostRead.length > 0,
  subscribe: true,
  about: Boolean(aboutLead || settings.authorPhotoUrl),
  latest: latest.length > 0,
  topics: topics.length > 0,
};
const blocks = layout.sections.filter((x) => x.visible && hasContent[x.key]);

const meta = pageMeta({ path: "/" }, settings, siteUrl(envFrom(Astro.locals)));
---

<Base meta={meta} home>
  <!-- 1. Hero: the featured essay -->
  <section class:list={["hero", { "has-image": featured?.coverUrl }]}>
    {featured?.coverUrl && <img class="hero-img" src={featured.coverUrl} alt="" fetchpriority="high" />}
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-inner">
      <SiteHeader settings={settings} pages={pages} currentPath="/" variant="overlay" />
      {featured ? (
        <div class="hero-body">
          <div class="hero-text">
            <div class="hero-kicker">Featured essay{featured.category && <> &middot; {featured.category.name}</>}</div>
            <h1><a href={`/blog/${featured.slug}`}>{featured.title}</a></h1>
            {featured.excerpt && <p class="hero-lede">{featured.excerpt}</p>}
          </div>
          <div class="hero-aside">
            <div class="hero-meta">
              <time datetime={isoDate(featured.publishedAt)}>{formatDate(featured.publishedAt)}</time>
              {mins(featured.bodyHtml) > 0 && <> &middot; {mins(featured.bodyHtml)} min read</>}
            </div>
            <a class="hero-link" href={`/blog/${featured.slug}`}>Read the essay &rarr;</a>
          </div>
        </div>
      ) : (
        <div class="hero-body">
          <div class="hero-text">
            <div class="hero-kicker">Welcome</div>
            <h1>{settings.title}</h1>
            <p class="hero-lede">The first essay is on its way. Check back soon.</p>
          </div>
        </div>
      )}
    </div>
  </section>

  <div class="home-secs">
  {blocks.map((x) => (
    x.key === "mostRead" ? (
      <div class={`home-sec home-sec--${x.key}`}>
        {mostRead.length > 0 && (
          <section class="wrap home-block" id="most-read">
            <div class="block-head">
              <h2>{section.mostRead.title}</h2>
              <a href="/blog">All essays &rarr;</a>
            </div>
            <ol class="most-read">
              {mostRead.map((p, i) => (
                <li>
                  <div class="rank">{String(i + 1).padStart(2, "0")}</div>
                  <div>
                    <h3><a href={`/blog/${p.slug}`}>{p.title}</a></h3>
                    <div class="meta">
                      {p.category?.name}{p.category && mins(p.bodyHtml) > 0 && " · "}{mins(p.bodyHtml) > 0 && `${mins(p.bodyHtml)} min`}
                    </div>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>
    ) : x.key === "subscribe" ? (
      <div class={`home-sec home-sec--${x.key}`}>
        <div class="wrap home-subscribe"><Subscribe variant="band" /></div>
      </div>
    ) : x.key === "about" ? (
      <div class={`home-sec home-sec--${x.key}`}>
        {(aboutLead || settings.authorPhotoUrl) && (
          <section class="wrap about-block">
            <figure class="portrait">
              <div class="portrait-frame">
                {settings.authorPhotoUrl ? (
                  <img src={settings.authorPhotoUrl} alt={`Portrait of ${settings.authorName}`} loading="lazy" />
                ) : (
                  <div class="monogram" aria-hidden="true"><span>{initials}</span></div>
                )}
              </div>
              <figcaption>
                <span class="nm">{settings.authorName}</span>
                {settings.tagline && <span class="tl">{settings.tagline}</span>}
              </figcaption>
            </figure>
            <div class="about-text">
              <div class="label accent">{section.about.title}</div>
              {aboutLead && <p class="about-lead">{aboutLead}</p>}
              {aboutBody && <p class="about-body">{aboutBody}</p>}
              {about && <a class="text-link" href="/about">More about me &rarr;</a>}
            </div>
          </section>
        )}
      </div>
    ) : x.key === "latest" ? (
      <div class={`home-sec home-sec--${x.key}`}>
        {latest.length > 0 && (
          <section class="wrap home-block">
            <div class="block-head">
              <h2>{section.latest.title}</h2>
              <a href="/blog">All essays &rarr;</a>
            </div>
            <div class="latest">
              {latest.map((p) => (
                <article>
                  <a class="thumb" href={`/blog/${p.slug}`} tabindex="-1" aria-hidden="true">
                    {p.coverUrl ? <img src={p.coverUrl} alt="" loading="lazy" /> : <span>{p.category?.name ?? settings.title}</span>}
                  </a>
                  <div>
                    <div class="meta">
                      {p.category?.name}{p.category && mins(p.bodyHtml) > 0 && " · "}{mins(p.bodyHtml) > 0 && `${mins(p.bodyHtml)} min`}
                    </div>
                    <h3><a href={`/blog/${p.slug}`}>{p.title}</a></h3>
                    {p.excerpt && <p class="excerpt">{p.excerpt}</p>}
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}
      </div>
    ) : x.key === "topics" ? (
      <div class={`home-sec home-sec--${x.key}`}>
        {topics.length > 0 && (
          <div class="ruled">
            <section class="wrap rail wander">
              <div class="label">{section.topics.title}</div>
              <div class="wander-links">
                {topics.map((t) => <a href={`/category/${t.slug}`}>{t.name}<sup>{t.count}</sup></a>)}
              </div>
            </section>
          </div>
        )}
      </div>
    ) : null
  ))}
  </div>
</Base>
