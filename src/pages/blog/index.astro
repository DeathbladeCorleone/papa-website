---
import Base from "@/layouts/Base.astro";
import EssayIndex from "@/components/EssayIndex.astro";
import { repoFrom, envFrom } from "@/lib/context";
import { pageMeta } from "@/lib/domain/seo";
import { siteUrl, SITE } from "@/config/site";

const repo = repoFrom(Astro.locals);
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const [settings, posts, total, categories] = await Promise.all([
  repo.getSettings(),
  repo.listPublished({ limit: SITE.pageSize, offset: (page - 1) * SITE.pageSize }),
  repo.countPublished(),
  repo.listCategories(),
]);
const totalPages = Math.max(1, Math.ceil(total / SITE.pageSize));
const subtitle = total === 0 ? "No essays yet." : `${total} ${total === 1 ? "essay" : "essays"}, newest first.`;
const meta = pageMeta({ path: "/blog", title: "All essays" }, settings, siteUrl(envFrom(Astro.locals)));
---

<Base meta={meta}>
  <EssayIndex
    title="All essays"
    subtitle={subtitle}
    posts={posts}
    categories={categories}
    activeFilter="all"
    page={page}
    totalPages={totalPages}
    basePath="/blog"
    emptyText="The first essay is on its way."
  />
</Base>
