---
import Base from "@/layouts/Base.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import Comments from "@/components/Comments.astro";
import Subscribe from "@/components/Subscribe.astro";
import { repoFrom, envFrom } from "@/lib/context";
import { withHeadingIds } from "@/lib/domain/toc";
import { readingTimeMinutes } from "@/lib/domain/reading-time";
import { articleMeta, articleJsonLd, pageMeta } from "@/lib/domain/seo";
import { formatDate, isoDate } from "@/lib/format";
import { siteUrl } from "@/config/site";
import { isLikelyBot } from "@/lib/domain/bots";
import { authConfig, verifySession, SESSION_COOKIE } from "@/lib/auth";

const { slug = "" } = Astro.params;
const repo = repoFrom(Astro.locals);
const url = siteUrl(envFrom(Astro.locals));
const [settings, livePost] = await Promise.all([repo.getSettings(), repo.getPublishedBySlug(slug)]);

// ?preview lets a signed-in author see a draft or scheduled essay exactly as readers will.
let post = livePost;
let previewing = false;
if (!post && Astro.url.searchParams.has("preview")) {
  const cfg = authConfig(envFrom(Astro.locals), import.meta.env.DEV);
  const token = Astro.cookies.get(SESSION_COOKIE)?.value;
  if (cfg && token && (await verifySession(token, cfg))) {
    post = (await repo.listAllPosts()).find((p) => p.slug === slug) ?? null;
    previewing = Boolean(post);
    Astro.response.headers.set("Cache-Control", "no-store");
    Astro.response.headers.set("X-Robots-Tag", "noindex");
  }
}
if (!post) Astro.response.status = 404;

// Count a view for "Most read" (skip crawlers and link previews; never block the page on it).
if (post && !previewing && !isLikelyBot(Astro.request.headers.get("user-agent"))) {
  await repo.recordView(post.id).catch(() => {});
}

const rendered = post ? withHeadingIds(post.bodyHtml) : null;
const [similar, recentPosts, comments] = post
  ? await Promise.all([repo.relatedPosts(post, 3), repo.listPublished({ limit: 5 }), repo.listApprovedForPost(post.id)])
  : [[], [], []];
// Prefer posts sharing a topic or tag; top up with the newest essays so there are three.
const related = [...similar];
for (const p of recentPosts) {
  if (related.length >= 3) break;
  if (p.id !== post?.id && !related.some((r) => r.id === p.id)) related.push(p);
}
const mins = post ? readingTimeMinutes(post.bodyHtml) : 0;
const shareUrl = post ? `${url}/blog/${post.slug}` : url;

const meta = post
  ? articleMeta(post, settings, url)
  : pageMeta({ path: Astro.url.pathname, title: "Not found" }, settings, url);
const jsonLd = post ? articleJsonLd(post, settings, url) : undefined;
---

<Base meta={meta} jsonLd={jsonLd}>
  {previewing && (
    <div class="preview-bar" role="status">
      <span><strong>Preview.</strong> Only you can see this — it isn't published yet.</span>
      <a href={`/admin/posts/${post!.id}`}>Back to editing</a>
    </div>
  )}
  {!post || !rendered ? (
    <section class="wrap simple-page">
      <h1>Essay not found</h1>
      <p class="empty">It may have been moved or unpublished.</p>
      <a class="text-link" href="/blog">&larr; All essays</a>
      <div class="page-footer-gap"></div>
    </section>
  ) : (
    <>
      <section class="wrap article-head">
        <div class="inner">
          {post.category && <a class="label accent" href={`/category/${post.category.slug}`}>{post.category.name}</a>}
          <h1>{post.title}</h1>
          <div class="meta">
            By {settings.authorName} &middot; <time datetime={isoDate(post.publishedAt)}>{formatDate(post.publishedAt)}</time>
            {mins > 0 && <> &middot; {mins} min read</>}
          </div>
        </div>
      </section>

      {post.coverUrl && (
        <section class="wrap article-cover">
          <img src={post.coverUrl} alt="" fetchpriority="high" />
        </section>
      )}

      <section class="wrap article-grid">
        <aside class="article-aside">
          <TableOfContents entries={rendered.toc} variant="aside" />
          <div class:list={[{ "aside-share": rendered.toc.length >= 2 }]}>
            <div class="label" style="border:0;padding-bottom:10px">Share</div>
            <ShareButtons url={shareUrl} title={post.title} showLabel={false} />
          </div>
        </aside>

        <div>
          <TableOfContents entries={rendered.toc} variant="mobile" />
          <article class="prose" set:html={rendered.html} />

          {post.tags.length > 0 && (
            <div class="article-tags">
              <span class="label">Tags</span>
              {post.tags.map((t) => <a class="pill" href={`/tag/${t.slug}`}>{t.name}</a>)}
            </div>
          )}
          <ShareButtons url={shareUrl} title={post.title} class="share-mobile" />

          <Comments post={post} comments={comments} />
        </div>
        <div class="spacer"></div>
      </section>

      {related.length > 0 && (
        <div class="wrap">
          <section class="related">
            <div class="label">Related</div>
            <div class="grid">
              {related.map((r) => {
                const m = readingTimeMinutes(r.bodyHtml);
                return (
                  <div>
                    <div class="meta">
                      {r.category?.name}{r.category && m > 0 && " · "}{m > 0 && `${m} min`}
                    </div>
                    <h3><a href={`/blog/${r.slug}`}>{r.title}</a></h3>
                  </div>
                );
              })}
            </div>
          </section>
        </div>
      )}

      <div class="wrap">
        <Subscribe variant="banner" />
      </div>
      <div class="page-footer-gap"></div>
    </>
  )}
</Base>
