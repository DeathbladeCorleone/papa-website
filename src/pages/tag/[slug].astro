---
import Base from "@/layouts/Base.astro";
import EssayIndex from "@/components/EssayIndex.astro";
import { repoFrom, envFrom } from "@/lib/context";
import { pageMeta } from "@/lib/domain/seo";
import { siteUrl, SITE } from "@/config/site";

const { slug = "" } = Astro.params;
const repo = repoFrom(Astro.locals);
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const [settings, tag, categories] = await Promise.all([
  repo.getSettings(),
  repo.getTagBySlug(slug),
  repo.listCategories(),
]);
if (!tag) Astro.response.status = 404;

const [posts, total] = tag
  ? await Promise.all([
      repo.listPublished({ tagSlug: tag.slug, limit: SITE.pageSize, offset: (page - 1) * SITE.pageSize }),
      repo.countPublished({ tagSlug: tag.slug }),
    ])
  : [[], 0];
const totalPages = Math.max(1, Math.ceil(total / SITE.pageSize));
const meta = pageMeta(
  { path: `/tag/${slug}`, title: tag ? `Tagged “${tag.name}”` : "Not found" },
  settings,
  siteUrl(envFrom(Astro.locals)),
);
---

<Base meta={meta}>
  <EssayIndex
    title={tag ? tag.name : "Tag not found"}
    subtitle={tag ? `${total} ${total === 1 ? "essay" : "essays"} tagged “${tag.name}”.` : "This tag doesn’t exist, or has moved."}
    posts={posts}
    categories={categories}
    page={page}
    totalPages={totalPages}
    basePath={`/tag/${slug}`}
    emptyText="Nothing with this tag yet."
  />
</Base>
