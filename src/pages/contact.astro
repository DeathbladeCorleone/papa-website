---
import Base from "@/layouts/Base.astro";
import { repoFrom, envFrom } from "@/lib/context";
import { pageMeta } from "@/lib/domain/seo";
import { siteUrl } from "@/config/site";

const repo = repoFrom(Astro.locals);
const settings = await repo.getSettings();
// Optional CMS "contact" page provides the intro copy above the form.
const cms = await repo.getPublishedPageBySlug("contact");
const meta = pageMeta({ path: "/contact", title: "Contact" }, settings, siteUrl(envFrom(Astro.locals)));
const status = Astro.url.searchParams.get("sent");
---

<Base meta={meta}>
  <section class="wrap rail simple-page">
    <div class="label">Contact</div>
    <div class="measure">
      <h1>{cms?.title ?? "Get in touch"}</h1>
      {cms ? (
        <div class="prose" set:html={cms.bodyHtml} />
      ) : (
        <p class="lede-sans" style="margin:20px 0 0;font-size:19px;line-height:1.6;color:var(--ink-soft)">Have a question, a thought on an essay, or just want to say hello? Write below — it comes straight to me.</p>
      )}

      {status === "1" && <p class="notice ok">Thank you — your message has been sent.</p>}
      {status === "error" && <p class="notice err">Something went wrong. Please check the form and try again.</p>}

      <form method="POST" action="/api/contact" class="comment-form" style="margin-top:36px;max-width:none">
        <div class="honeypot" aria-hidden="true">
          <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="row" style="margin-top:0">
          <label class="visually-hidden" for="name">Name</label>
          <input type="text" id="name" name="name" placeholder="Name" required minlength="2" maxlength="80" />
          <label class="visually-hidden" for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="Email" required />
        </div>
        <label class="visually-hidden" for="body">Message</label>
        <textarea id="body" name="body" rows="6" placeholder="Your message" required minlength="2" maxlength="5000"></textarea>
        <div class="actions">
          <button class="btn" type="submit">Send message</button>
          <span class="hint">Your email is only used to reply to you.</span>
        </div>
      </form>
    </div>
  </section>
  <div class="page-footer-gap"></div>
</Base>
