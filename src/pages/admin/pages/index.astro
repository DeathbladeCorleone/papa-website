---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Icon from "@/components/admin/Icon.astro";
import { repoFrom } from "@/lib/context";
import { formatDate } from "@/lib/format";

const pages = await repoFrom(Astro.locals).listAllPages();
---

<AdminLayout title="Pages">
  <header class="a-head">
    <div>
      <div class="a-kicker">Write</div>
      <h1>Pages</h1>
      <p class="lede">Pages that stay put, like About or Contact. Published pages can appear in the website's menu.</p>
    </div>
    <div class="actions">
      <a class="a-btn ghost" href="/admin/menu"><Icon name="menu" size={16} /> Arrange the menu</a>
      <a class="a-btn" href="/admin/pages/new"><Icon name="plus" size={16} /> New page</a>
    </div>
  </header>

  {pages.length === 0 ? (
    <div class="a-empty">
      <h3>No pages yet</h3>
      <p>An About page is a good first one — the home page shows its opening lines.</p>
      <a class="a-btn" href="/admin/pages/new"><Icon name="plus" size={16} /> New page</a>
    </div>
  ) : (
    <div class="a-list" style="margin-top:18px">
      {pages.map((p) => (
        <div class="a-row no-thumb">
          <div>
            <a class="t" href={`/admin/pages/${p.id}`}>{p.title}</a>
            <div class="m">
              <span class={`a-badge st-inline ${p.status}`}>{p.status === "published" ? "Published" : "Draft"}</span>
              <span>/{p.slug}</span>
              <span class="dot"></span>
              <span>{p.showInMenu ? "In the menu" : "Not in the menu"}</span>
              <span class="dot"></span>
              <span>Edited {formatDate(p.updatedAt)}</span>
            </div>
          </div>
          <div class="st"><span class={`a-badge ${p.status}`}>{p.status === "published" ? "Published" : "Draft"}</span></div>
          <div class="num">{p.showInMenu && p.status === "published" ? "In menu" : ""}</div>
          <div class="acts">
            <a class="a-btn ghost sm" href={`/admin/pages/${p.id}`}>Edit</a>
            <details class="a-menu">
              <summary class="a-btn quiet sm icon" aria-label="More actions"><Icon name="more" /></summary>
              <div class="pop">
                {p.status === "published" && <a href={`/${p.slug}`} target="_blank" rel="noopener"><Icon name="external" size={16} /> View on website</a>}
                <form method="POST" action="/api/admin/pages">
                  <input type="hidden" name="_action" value={p.status === "published" ? "unpublish" : "publish"} />
                  <input type="hidden" name="id" value={p.id} />
                  <button type="submit"><Icon name={p.status === "published" ? "undo" : "check"} size={16} /> {p.status === "published" ? "Move back to drafts" : "Publish now"}</button>
                </form>
                <form method="POST" action="/api/admin/pages">
                  <input type="hidden" name="_action" value="menu" />
                  <input type="hidden" name="id" value={p.id} />
                  <input type="hidden" name="show" value={p.showInMenu ? "0" : "1"} />
                  <button type="submit"><Icon name="menu" size={16} /> {p.showInMenu ? "Hide from the menu" : "Show in the menu"}</button>
                </form>
                <hr />
                <form method="POST" action="/api/admin/pages" data-confirm={`Delete the page “${p.title}” for good?`}>
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={p.id} />
                  <button type="submit" class="danger"><Icon name="trash" size={16} /> Delete</button>
                </form>
              </div>
            </details>
          </div>
        </div>
      ))}
    </div>
  )}
</AdminLayout>
