---
import AdminLayout from "@/layouts/AdminLayout.astro";
import PostEditor from "@/components/admin/editor/PostEditor.tsx";

const initial = {
  id: null, slug: "", title: "", excerpt: "", bodyHtml: "", coverUrl: null, categoryId: null, tags: [],
  featured: false, seoTitle: null, seoDescription: null, status: "draft" as const, publishedAt: null, updatedAt: null,
  state: "draft" as const, showInMenu: true,
};
---

<AdminLayout title="New page" bare>
  <PostEditor client:only="react" kind="page" initial={initial} categories={[]} allTags={[]} />
</AdminLayout>
