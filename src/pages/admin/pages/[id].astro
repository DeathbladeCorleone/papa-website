---
import AdminLayout from "@/layouts/AdminLayout.astro";
import PostEditor from "@/components/admin/editor/PostEditor.tsx";
import { repoFrom } from "@/lib/context";

const page = Astro.params.id ? await repoFrom(Astro.locals).getPageById(Astro.params.id) : null;
if (!page) return Astro.redirect("/admin/pages");
const initial = {
  id: page.id, slug: page.slug, title: page.title, excerpt: "", bodyHtml: page.bodyHtml, coverUrl: null, categoryId: null, tags: [],
  featured: false, seoTitle: null, seoDescription: null, status: page.status, publishedAt: null, updatedAt: page.updatedAt,
  state: page.status, showInMenu: page.showInMenu,
};
---

<AdminLayout title={page.title} bare>
  <PostEditor client:only="react" kind="page" initial={initial} categories={[]} allTags={[]} />
</AdminLayout>
