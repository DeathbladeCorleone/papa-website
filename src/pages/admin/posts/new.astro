---
import AdminLayout from "@/layouts/AdminLayout.astro";
import PostEditor from "@/components/admin/editor/PostEditor.tsx";
import { repoFrom } from "@/lib/context";

const repo = repoFrom(Astro.locals);
const [categories, tags] = await Promise.all([repo.listCategories(), repo.listTags()]);
const initial = {
  id: null, slug: "", title: "", excerpt: "", bodyHtml: "", coverUrl: null, categoryId: null, tags: [],
  featured: false, seoTitle: null, seoDescription: null, status: "draft" as const, publishedAt: null, updatedAt: null, state: "draft" as const,
};
---

<AdminLayout title="New essay" bare>
  <PostEditor
    client:only="react"
    kind="post"
    initial={initial}
    categories={categories.map((c) => ({ id: c.id, name: c.name }))}
    allTags={tags.map((t) => t.name)}
  />
</AdminLayout>
