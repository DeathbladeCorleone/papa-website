---
import AdminLayout from "@/layouts/AdminLayout.astro";
import PostEditor from "@/components/admin/editor/PostEditor.tsx";
import { repoFrom } from "@/lib/context";
import { postState } from "@/lib/domain/schedule";

const repo = repoFrom(Astro.locals);
const post = Astro.params.id ? await repo.getPostById(Astro.params.id) : null;
if (!post) return Astro.redirect("/admin/posts");
const [categories, tags] = await Promise.all([repo.listCategories(), repo.listTags()]);
const initial = {
  id: post.id,
  slug: post.slug,
  title: post.title,
  excerpt: post.excerpt,
  bodyHtml: post.bodyHtml,
  coverUrl: post.coverUrl,
  categoryId: post.categoryId,
  tags: post.tags.map((t) => t.name),
  featured: post.featured,
  seoTitle: post.seoTitle,
  seoDescription: post.seoDescription,
  status: post.status,
  publishedAt: post.publishedAt,
  updatedAt: post.updatedAt,
  state: postState(post),
};
---

<AdminLayout title={post.title} bare>
  <PostEditor
    client:only="react"
    kind="post"
    initial={initial}
    categories={categories.map((c) => ({ id: c.id, name: c.name }))}
    allTags={tags.map((t) => t.name)}
  />
</AdminLayout>
