---
import AdminLayout from "@/layouts/AdminLayout.astro";
import PostForm from "@/components/admin/PostForm.astro";
import { repoFrom } from "@/lib/context";

const { id } = Astro.params;
const repo = repoFrom(Astro.locals);
const [post, categories, pending] = await Promise.all([
  id ? repo.getPostById(id) : Promise.resolve(null),
  repo.listCategories(),
  repo.listCommentsByStatus("pending"),
]);

if (!post) {
  Astro.response.status = 404;
}
const saved = Astro.url.searchParams.get("saved");
const error = Astro.url.searchParams.get("error");
---

<AdminLayout title={post ? `Edit: ${post.title}` : "Not found"} pending={pending.length}>
  {post ? (
    <>
      <div class="toolbar" style="justify-content:space-between">
        <h1 style="margin:0">Edit post</h1>
        <span class={`pill ${post.status}`}>{post.status}</span>
      </div>
      {saved && <p class="notice ok">Saved.</p>}
      {error === "title" && <p class="notice err">Please enter a title.</p>}
      <PostForm post={post} categories={categories} />
    </>
  ) : (
    <>
      <h1>Post not found</h1>
      <p><a class="btn secondary" href="/admin/posts">← Back to posts</a></p>
    </>
  )}
</AdminLayout>
