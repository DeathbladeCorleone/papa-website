---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { repoFrom } from "@/lib/context";
import { formatDate } from "@/lib/format";

const repo = repoFrom(Astro.locals);
const [posts, pending] = await Promise.all([
  repo.listAllPosts(),
  repo.listCommentsByStatus("pending"),
]);
---

<AdminLayout title="Posts" pending={pending.length}>
  <div class="toolbar" style="justify-content:space-between">
    <h1 style="margin:0">Posts</h1>
    <a class="btn" href="/admin/posts/new">✎ New post</a>
  </div>

  <table class="admin-table">
    <thead>
      <tr><th>Title</th><th>Status</th><th>Updated</th><th>Actions</th></tr>
    </thead>
    <tbody>
      {posts.map((p) => (
        <tr>
          <td>
            <a href={`/admin/posts/${p.id}`}>{p.title}</a>
            {p.featured && <span class="pill" style="margin-left:0.5rem">featured</span>}
          </td>
          <td><span class={`pill ${p.status}`}>{p.status}</span></td>
          <td class="muted">{formatDate(p.updatedAt)}</td>
          <td>
            <a class="btn secondary small" href={`/admin/posts/${p.id}`}>Edit</a>
            {p.status === "published" ? (
              <form class="inline-form" method="POST" action="/api/admin/posts">
                <input type="hidden" name="_action" value="unpublish" />
                <input type="hidden" name="id" value={p.id} />
                <button class="btn secondary small" type="submit">Unpublish</button>
              </form>
            ) : (
              <form class="inline-form" method="POST" action="/api/admin/posts">
                <input type="hidden" name="_action" value="publish" />
                <input type="hidden" name="id" value={p.id} />
                <button class="btn secondary small" type="submit">Publish</button>
              </form>
            )}
            <form class="inline-form" method="POST" action="/api/admin/posts" data-confirm="Delete this post permanently?">
              <input type="hidden" name="_action" value="delete" />
              <input type="hidden" name="id" value={p.id} />
              <button class="btn danger small" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      ))}
      {posts.length === 0 && <tr><td colspan="4" class="muted">No posts yet.</td></tr>}
    </tbody>
  </table>
</AdminLayout>
