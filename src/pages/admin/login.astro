---
import "@/styles/theme.css";
import { envFrom } from "@/lib/context";
import { authConfig } from "@/lib/auth";
const error = Astro.url.searchParams.get("error");
const cfg = authConfig(envFrom(Astro.locals), import.meta.env.DEV);
const devLogin = cfg?.devPassword != null;
const messages: Record<string, string> = {
  "1": "Incorrect email or password.",
  locked: "Too many attempts. Please wait 15 minutes and try again.",
  config: "Admin login isn't set up yet. Ask whoever runs this site to configure it.",
};
// Already logged in? Go to the dashboard.
if (Astro.locals.admin) return Astro.redirect("/admin");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet" />
  </head>
  <body style="display:grid;place-items:center;min-height:100vh">
    <main style="width:min(24rem,90vw)">
      <h1 style="text-align:center">Sign in</h1>
      {!cfg && <p class="notice err">{messages.config}</p>}
      {cfg && error && <p class="notice err">{messages[error] ?? messages["1"]}</p>}
      {devLogin && (
        <p class="notice info small">Local development — sign in with <code>{cfg?.email}</code> / <code>changeme</code>.</p>
      )}
      <form method="POST" action="/api/admin/login" class="stack" style="margin-top:1rem">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autocomplete="username" />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required autocomplete="current-password" />
        </div>
        <button class="btn" type="submit" style="width:100%">Sign in</button>
      </form>
      <p class="center small muted" style="margin-top:1.5rem"><a href="/">← Back to site</a></p>
    </main>
  </body>
</html>
