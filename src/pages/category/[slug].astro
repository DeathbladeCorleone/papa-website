---
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import { repoFrom, envFrom } from "@/lib/context";
import { pageMeta } from "@/lib/domain/seo";
import { siteUrl, SITE } from "@/config/site";

const { slug } = Astro.params;
const repo = repoFrom(Astro.locals);
const settings = await repo.getSettings();
const category = slug ? await repo.getCategoryBySlug(slug) : null;
if (!category) Astro.response.status = 404;

const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const offset = (page - 1) * SITE.pageSize;
const [posts, total] = category
  ? await Promise.all([
      repo.listPublished({ categorySlug: category.slug, limit: SITE.pageSize, offset }),
      repo.countPublished({ categorySlug: category.slug }),
    ])
  : [[], 0];
const totalPages = Math.max(1, Math.ceil(total / SITE.pageSize));
const meta = pageMeta(
  { path: `/category/${slug}`, title: category ? category.name : "Category" },
  settings,
  siteUrl(envFrom(Astro.locals)),
);
---

<Base meta={meta}>
  {category ? (
    <>
      <h1 class="measure">{category.name}</h1>
      {posts.length > 0 ? (
        <div class="post-list measure">{posts.map((p) => <PostCard post={p} />)}</div>
      ) : (
        <p class="muted measure">No posts in this category yet.</p>
      )}
      {totalPages > 1 && (
        <nav class="pagination measure" aria-label="Pagination">
          {page > 1 ? <a href={`/category/${category.slug}?page=${page - 1}`}>← Newer</a> : <span></span>}
          <span class="muted">Page {page} of {totalPages}</span>
          {page < totalPages ? <a href={`/category/${category.slug}?page=${page + 1}`}>Older →</a> : <span></span>}
        </nav>
      )}
    </>
  ) : (
    <div class="measure center" style="padding:4rem 0"><h1>Category not found</h1></div>
  )}
</Base>
