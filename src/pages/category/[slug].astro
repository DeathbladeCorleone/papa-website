---
import Base from "@/layouts/Base.astro";
import EssayIndex from "@/components/EssayIndex.astro";
import { repoFrom, envFrom } from "@/lib/context";
import { pageMeta } from "@/lib/domain/seo";
import { siteUrl, SITE } from "@/config/site";

const { slug = "" } = Astro.params;
const repo = repoFrom(Astro.locals);
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const [settings, category, categories] = await Promise.all([
  repo.getSettings(),
  repo.getCategoryBySlug(slug),
  repo.listCategories(),
]);
if (!category) Astro.response.status = 404;

const [posts, total] = category
  ? await Promise.all([
      repo.listPublished({ categorySlug: category.slug, limit: SITE.pageSize, offset: (page - 1) * SITE.pageSize }),
      repo.countPublished({ categorySlug: category.slug }),
    ])
  : [[], 0];
const totalPages = Math.max(1, Math.ceil(total / SITE.pageSize));
const meta = pageMeta(
  { path: `/category/${slug}`, title: category?.name ?? "Not found" },
  settings,
  siteUrl(envFrom(Astro.locals)),
);
---

<Base meta={meta}>
  <EssayIndex
    title={category?.name ?? "Topic not found"}
    subtitle={category ? `${total} ${total === 1 ? "essay" : "essays"} in ${category.name}.` : "This topic doesn’t exist, or has moved."}
    posts={posts}
    categories={categories}
    activeFilter={category ? category.slug : "all"}
    page={page}
    totalPages={totalPages}
    basePath={`/category/${slug}`}
    emptyText="Nothing in this topic yet."
  />
</Base>
