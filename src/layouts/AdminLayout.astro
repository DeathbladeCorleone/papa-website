---
import "@/styles/theme.css";
import "@/styles/admin.css";
import "@/styles/editor.css";
import Icon from "@/components/admin/Icon.astro";
import type { IconName } from "@/components/admin/icons";
import { repoFrom, usingDemoData } from "@/lib/context";

interface Props {
  title: string;
  /** "bare" drops the sidebar (the full-screen editor). */
  bare?: boolean;
  /** Kept for older pages; badge counts are now computed here. */
  pending?: number;
}
const { title, bare = false } = Astro.props;
const admin = Astro.locals.admin;
const path = Astro.url.pathname;
const demo = usingDemoData(Astro.locals);

const repo = repoFrom(Astro.locals);
const [settings, pendingComments, messages] = await Promise.all([
  repo.getSettings(),
  repo.listCommentsByStatus("pending"),
  repo.listMessages(),
]);
const unread = messages.filter((m) => !m.read).length;

type Link = { href: string; label: string; icon: IconName; count?: number };
const groups: { name: string; links: Link[] }[] = [
  {
    name: "Write",
    links: [
      { href: "/admin", label: "Overview", icon: "home" },
      { href: "/admin/posts", label: "Essays", icon: "pen" },
      { href: "/admin/pages", label: "Pages", icon: "doc" },
    ],
  },
  {
    name: "Readers",
    links: [
      { href: "/admin/comments", label: "Comments", icon: "chat", count: pendingComments.length },
      { href: "/admin/messages", label: "Messages", icon: "mail", count: unread },
      { href: "/admin/subscribers", label: "Subscribers", icon: "users" },
    ],
  },
  {
    name: "Website",
    links: [
      { href: "/admin/homepage", label: "Home page", icon: "layout" },
      { href: "/admin/menu", label: "Menu & topics", icon: "menu" },
      { href: "/admin/media", label: "Photos", icon: "images" },
      { href: "/admin/settings", label: "Settings", icon: "gear" },
    ],
  },
];
const active = (href: string) => (href === "/admin" ? path === "/admin" || path === "/admin/" : path.startsWith(href));

// One-off confirmations passed back by form actions as ?saved=1 etc.
const q = Astro.url.searchParams;
const toasts: Record<string, string> = {
  saved: "Saved",
  deleted: "Deleted",
  updated: "Updated",
  published: "Published",
  unpublished: "Moved back to drafts",
  featured: "Now featured on the home page",
};
const toast = Object.keys(toasts).find((k) => q.has(k));
const firstName = settings.authorName.split(/\s+/)[0] || settings.authorName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · {settings.title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />
  </head>
  <body class="admin">
    {bare ? (
      <slot />
    ) : (
      <div class="a-shell">
        <aside class="a-side" id="a-side" aria-label="Dashboard navigation">
          <div class="a-brand">
            <a href="/admin"><span class="wm">{settings.title}</span></a>
            <span class="sub">Dashboard</span>
          </div>
          <a class="a-write" href="/admin/posts/new"><Icon name="pen" size={17} /> Write an essay</a>
          <nav class="a-nav">
            {groups.map((g) => (
              <>
                <div class="grp">{g.name}</div>
                {g.links.map((l) => (
                  <a href={l.href} aria-current={active(l.href) ? "page" : undefined}>
                    <Icon name={l.icon} />
                    <span>{l.label}</span>
                    {l.count ? <span class="count" aria-label={`${l.count} new`}>{l.count}</span> : null}
                  </a>
                ))}
              </>
            ))}
          </nav>
          <div class="a-side-foot">
            <a href="/" target="_blank" rel="noopener"><Icon name="external" size={16} /> View the website</a>
            <form method="POST" action="/api/admin/logout">
              <button type="submit"><Icon name="logout" size={16} /> Sign out</button>
            </form>
            {admin && <div class="who" title={admin.email}>Signed in as {firstName}</div>}
          </div>
        </aside>
        <div class="a-scrim" data-nav-close></div>
        <div>
          <header class="a-mobilebar">
            <a class="wm" href="/admin">{settings.title}</a>
            <button type="button" data-nav-open aria-controls="a-side" aria-expanded="false"><Icon name="menu" /> Menu</button>
          </header>
          <main class="a-main">
            {demo && (
              <p class="a-notice warn">
                <strong>Demo mode.</strong> No database is connected, so changes here are kept in memory and reset on restart.
              </p>
            )}
            <slot />
          </main>
        </div>
      </div>
    )}
    {toast && <div class="a-toast" role="status"><Fragment set:html={`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12.5 4.5 4.5L19 7"/></svg>`} />{toasts[toast]}</div>}
    <script is:inline>
      // Confirm dangerous actions on forms marked data-confirm.
      document.addEventListener("submit", (e) => {
        const form = e.target;
        const msg = form && form.getAttribute && form.getAttribute("data-confirm");
        if (msg && !window.confirm(msg)) e.preventDefault();
      });
      // Mobile navigation drawer.
      document.addEventListener("click", (e) => {
        const t = e.target instanceof Element ? e.target : null;
        if (!t) return;
        if (t.closest("[data-nav-open]")) document.body.classList.add("nav-open");
        else if (t.closest("[data-nav-close]")) document.body.classList.remove("nav-open");
        // Close any open dropdown menus when clicking elsewhere.
        document.querySelectorAll("details.a-menu[open]").forEach((d) => { if (!d.contains(t)) d.removeAttribute("open"); });
      });
      // Drop the one-off ?saved=1 style flags so a refresh doesn't repeat the toast.
      (() => {
        const u = new URL(location.href);
        let changed = false;
        for (const k of ["saved", "deleted", "updated", "published", "unpublished", "featured"]) {
          if (u.searchParams.has(k)) { u.searchParams.delete(k); changed = true; }
        }
        if (changed) history.replaceState(null, "", u.pathname + (u.search ? u.search : "") + u.hash);
      })();
    </script>
  </body>
</html>
