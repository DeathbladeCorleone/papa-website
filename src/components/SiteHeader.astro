---
import type { Page, SiteSettings } from "@/lib/domain/types";
interface Props {
  settings: SiteSettings;
  pages: Page[];
  currentPath: string;
  /** "overlay" sits on top of the home page hero image in light text. */
  variant?: "default" | "overlay";
}
const { settings, pages, currentPath, variant = "default" } = Astro.props;
const current = (href: string) =>
  (href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`)) ? "page" : undefined;
const hasAbout = pages.some((p) => p.slug === "about");
---

{variant === "overlay" ? (
  <header class="hero-header">
    <nav class="hero-nav left" aria-label="Primary">
      <a href="/" aria-current={current("/")}>Home</a>
      <a href="/blog">Essays</a>
      {hasAbout && <a href="/about">About</a>}
    </nav>
    <div class="hero-brand">
      <a class="hero-wordmark" href="/">{settings.title}</a>
      {settings.tagline && <div class="hero-tagline">{settings.tagline}</div>}
    </div>
    <div class="hero-nav right">
      <a class="hide-mobile" href="/search">Search</a>
      <button class="menu-btn" type="button" data-menu-open aria-controls="site-menu" aria-expanded="false">
        <span>Menu</span><span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </header>
) : (
  <header class="site-header">
    <div class="wrap bar">
      <a class="wordmark" href="/">{settings.title}</a>
      <div class="header-right">
        <nav class="nav hide-mobile" aria-label="Primary">
          <a href="/" aria-current={current("/")}>Home</a>
          <a href="/blog" aria-current={current("/blog")}>Essays</a>
          {hasAbout && <a href="/about" aria-current={current("/about")}>About</a>}
          <a class="search-link" href="/search" aria-current={current("/search")}>
            <span class="search-icon" aria-hidden="true"></span><span>Search</span>
          </a>
        </nav>
        <button class="menu-btn" type="button" data-menu-open aria-controls="site-menu" aria-expanded="false">
          <span>Menu</span><span class="burger" aria-hidden="true"><span></span><span></span></span>
        </button>
      </div>
    </div>
  </header>
)}
