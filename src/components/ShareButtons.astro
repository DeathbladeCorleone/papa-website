---
interface Props { url: string; title: string; class?: string; showLabel?: boolean }
const { url, title, class: className = "", showLabel = true } = Astro.props;
const enc = encodeURIComponent;
const x = `https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(title)}`;
const wa = `https://wa.me/?text=${enc(`${title} ${url}`)}`;
---
<div class:list={["share", className]}>
  {showLabel && <span class="label">Share</span>}
  <a href={x} target="_blank" rel="noopener noreferrer">X</a>
  <a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a>
  <button type="button" class="copy-link" data-url={url}>Copy link</button>
</div>

<script is:inline>
  document.querySelectorAll(".copy-link").forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = "1";
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.url || location.href);
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = "Copy link"), 1800);
      } catch {
        window.prompt("Copy this link:", btn.dataset.url || location.href);
      }
    });
  });
</script>
