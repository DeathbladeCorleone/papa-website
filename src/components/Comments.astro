---
import type { Comment, PostWithRelations } from "@/lib/domain/types";
import { buildThreads, approvedCount } from "@/lib/domain/comments";
import { renderCommentBody } from "@/lib/domain/html";
import { formatDate, isoDate } from "@/lib/format";

interface Props { post: PostWithRelations; comments: Comment[] }
const { post, comments } = Astro.props;
const threads = buildThreads(comments);
const count = approvedCount(comments);
const status = Astro.url.searchParams.get("comment");
---

<section class="comments" id="comments">
  <div class="comments-head">
    <div class="label">Comments{count > 0 && <> &middot; {count}</>}</div>
    <div class="note">Moderated — new comments appear once approved.</div>
  </div>

  {status === "pending" && <p class="notice ok">Thank you — your comment will appear once it has been read.</p>}
  {status === "error" && <p class="notice err">Sorry, that didn’t go through. Please check your name, email and comment.</p>}

  {threads.map((t, i) => (
    <>
      {i > 0 && <div class="comment-divider"></div>}
      <div class="comment" id={`c-${t.id}`}>
        <div class="who">
          {t.authorName} &middot; <time datetime={isoDate(t.createdAt)}>{formatDate(t.createdAt)}</time>
          {t.isAuthor && <> &middot; Author</>}
        </div>
        <div class="body" set:html={renderCommentBody(t.body)} />
        {t.replies.map((r) => (
          <div class:list={["reply", { "is-author": r.isAuthor }]} id={`c-${r.id}`}>
            <div class="who">
              <span class="name">{r.authorName}</span>
              {r.isAuthor && <> &middot; Author</>} &middot; <time datetime={isoDate(r.createdAt)}>{formatDate(r.createdAt)}</time>
            </div>
            <div class="body" set:html={renderCommentBody(r.body)} />
          </div>
        ))}
        <button class="reply-btn" type="button" data-parent={t.id} data-name={t.authorName}>Reply</button>
      </div>
    </>
  ))}

  <div class="comment-divider"></div>

  <form class="comment-form" id="comment-form" method="POST" action="/api/comments">
    <div class="label">Leave a comment</div>
    <p class="reply-hint" id="reply-hint" hidden></p>
    <input type="hidden" name="post_id" value={post.id} />
    <input type="hidden" name="parent_id" id="parent_id" value="" />
    <div class="honeypot" aria-hidden="true">
      <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="row">
      <label class="visually-hidden" for="author_name">Name</label>
      <input type="text" id="author_name" name="author_name" placeholder="Name" required minlength="2" maxlength="80" />
      <label class="visually-hidden" for="author_email">Email</label>
      <input type="email" id="author_email" name="author_email" placeholder="Email (not published)" required />
    </div>
    <label class="visually-hidden" for="body">Comment</label>
    <textarea id="body" name="body" rows="4" placeholder="Your comment" required minlength="2" maxlength="5000"></textarea>
    <div class="actions">
      <button class="btn" type="submit">Post comment</button>
      <span class="hint">Your email stays private. Comments are read before they appear.</span>
    </div>
  </form>
</section>

<script is:inline>
  document.querySelectorAll(".reply-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const input = document.getElementById("parent_id");
      const hint = document.getElementById("reply-hint");
      if (input) input.value = btn.getAttribute("data-parent") || "";
      if (hint) {
        hint.textContent = "Replying to " + (btn.getAttribute("data-name") || "") + ".";
        hint.hidden = false;
      }
      document.getElementById("comment-form")?.scrollIntoView({ behavior: "smooth", block: "start" });
      document.getElementById("author_name")?.focus({ preventScroll: true });
    });
  });
</script>
