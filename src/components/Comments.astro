---
import type { Comment, PostWithRelations } from "@/lib/domain/types";
import { buildThreads, approvedCount } from "@/lib/domain/comments";
import { renderCommentBody } from "@/lib/domain/html";
import { formatDate, isoDate } from "@/lib/format";

interface Props { post: PostWithRelations; comments: Comment[] }
const { post, comments } = Astro.props;
const threads = buildThreads(comments);
const count = approvedCount(comments);

const status = Astro.url.searchParams.get("comment");
---

<section class="comments measure" id="comments">
  <h2>{count === 0 ? "Comments" : `${count} comment${count === 1 ? "" : "s"}`}</h2>

  {status === "pending" && (
    <p class="notice ok">Thank you — your comment has been submitted and will appear once approved.</p>
  )}
  {status === "error" && (
    <p class="notice err">Sorry, your comment could not be submitted. Please check your details and try again.</p>
  )}

  {threads.length === 0 && status !== "pending" && (
    <p class="muted">Be the first to comment.</p>
  )}

  <div class="thread-list">
    {threads.map((t) => (
      <div class={`comment${t.isAuthor ? " is-author" : ""}`} id={`c-${t.id}`}>
        <div>
          <span class="who">{t.authorName}</span>
          {t.isAuthor && <span class="badge">Author</span>}
          <time class="when" datetime={isoDate(t.createdAt)}>{formatDate(t.createdAt)}</time>
        </div>
        <div class="body" set:html={renderCommentBody(t.body)} />
        <button class="btn secondary small reply-btn" data-parent={t.id} data-name={t.authorName} type="button">Reply</button>
        {t.replies.length > 0 && (
          <div class="replies">
            {t.replies.map((r) => (
              <div class={`comment${r.isAuthor ? " is-author" : ""}`} id={`c-${r.id}`}>
                <div>
                  <span class="who">{r.authorName}</span>
                  {r.isAuthor && <span class="badge">Author</span>}
                  <time class="when" datetime={isoDate(r.createdAt)}>{formatDate(r.createdAt)}</time>
                </div>
                <div class="body" set:html={renderCommentBody(r.body)} />
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>

  <h3 id="comment-form">Leave a comment</h3>
  <p class="small muted" id="reply-hint" hidden></p>
  <form method="POST" action="/api/comments" class="stack">
    <input type="hidden" name="post_id" value={post.id} />
    <input type="hidden" name="parent_id" id="parent_id" value="" />
    <!-- Honeypot: bots fill this, humans never see it -->
    <div class="honeypot" aria-hidden="true">
      <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="grid-2">
      <div class="field">
        <label for="author_name">Name</label>
        <input type="text" id="author_name" name="author_name" required minlength="2" maxlength="80" />
      </div>
      <div class="field">
        <label for="author_email">Email <span class="muted">(never shown)</span></label>
        <input type="email" id="author_email" name="author_email" required />
      </div>
    </div>
    <div class="field">
      <label for="body">Comment</label>
      <textarea id="body" name="body" required minlength="2" maxlength="5000"></textarea>
    </div>
    <button class="btn" type="submit">Post comment</button>
  </form>
</section>

<script is:inline>
  document.querySelectorAll(".reply-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const parent = btn.getAttribute("data-parent") || "";
      const name = btn.getAttribute("data-name") || "";
      const input = document.getElementById("parent_id");
      const hint = document.getElementById("reply-hint");
      if (input) input.value = parent;
      if (hint) {
        hint.textContent = "Replying to " + name + " — clear the form to comment at the top level.";
        hint.hidden = false;
      }
      document.getElementById("comment-form")?.scrollIntoView({ behavior: "smooth" });
    });
  });
</script>
