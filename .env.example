# Copy to .env and fill in. Never commit .env.

# Public site URL (used for canonical URLs, sitemap, RSS, OG tags)
PUBLIC_SITE_URL="https://pradeepsingh.pages.dev"

# Supabase project (Settings -> API in the Supabase dashboard)
PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Never expose to the browser. Used for admin writes + moderation.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Secret for the keep-alive cron endpoint (any random string)
KEEPALIVE_SECRET="change-me"
